-            {
-                spdlog::warn("{}: DDS decode failed for '{}' (HRESULT 0x{:08X})",
-                             NameOf(NifPreviewRenderer),
-                             normalizedPath,
-                             static_cast<unsigned>(hr));
-                textureView.Reset();
-            }
-        }
-        else
-        {
-            spdlog::warn("{}: texture resource '{}' could not be read (status {})",
-                         NameOf(NifPreviewRenderer),
