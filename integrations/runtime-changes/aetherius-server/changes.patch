-
-  if (this->occupant == &activationSource) {
-    auto& loader = GetParent()->GetEspm();
-    auto base = loader.GetBrowser().LookupById(GetBaseId());
-    auto t = base.rec->GetType();
-    auto actorActivator = activationSource.AsActor();
