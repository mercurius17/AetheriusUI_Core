+std::string GetPropertyAlphabet()
+{
+  std::string alphabet;
+  for (char c = 'a'; c <= 'z'; c++) {
+    alphabet += c;
+  }
+  for (char c = 'A'; c <= 'Z'; c++) {
+    alphabet += c;
+  }
+  for (char c = '0'; c <= '9'; c++) {
+    alphabet += c;
+  }
+  alphabet += '_';
+  return alphabet;
+}
+
+bool StartsWith(const std::string& str, const char* prefix)
+{
+  return str.compare(0, strlen(prefix), prefix) == 0;
+}
