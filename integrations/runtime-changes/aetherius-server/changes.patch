+Napi::Value ScampServer::GetPrometheusMetrics(const Napi::CallbackInfo& info)
+{
+  try {
+    return Napi::String::New(info.Env(), promRegistry->serialize());
+  } catch (std::exception& e) {
+    throw Napi::Error::New(info.Env(), std::string(e.what()));
+  }
+}
