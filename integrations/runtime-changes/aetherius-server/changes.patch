+void MpObjectReference::DoReloot()
+{
+  if (ChangeForm().nextRelootDatetime) {
+    EditChangeForm([&](MpChangeFormREFR& changeForm) {
+      changeForm.nextRelootDatetime = 0;
+    });
+    SetOpen(false);
+    SetHarvested(false);
+    RelootContainer();
+  }
+}
