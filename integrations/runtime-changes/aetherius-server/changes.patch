-// Lists the plugin references (REFR) placed in one exterior chunk / interior
-// cell, straight from the loaded plugins. Read-only: unlike
-// GetNeighborsByPosition it attaches nothing to the WorldState, so it also
-// sees base types the server never loads (MSTT, STAT, LIGH...). Used by the
-// gamemode to find heat sources (campfires are MSTT).
-//
-// mp.lookupEspmRefsAtPos(cellOrWorldDesc, cellX, cellY)
-//   => [{ id, baseId, flags, type: "REFR" | "ACHR", pos: [x, y, z] }, ...]
-// cellX/cellY are pos / 4096, the same bucketing libespm uses for interiors
-// and exteriors alike.
-Napi::Value ScampServer::LookupEspmRefsAtPos(const Napi::CallbackInfo& info)
-{
-  try {
-    auto cellOrWorldDesc = FormDesc::FromString(
-      NapiHelper::ExtractString(info[0], "cellOrWorldDesc"));
-    auto cellX =
-      static_cast<int16_t>(NapiHelper::ExtractInt32(info[1], "cellX"));
-    auto cellY =
-      static_cast<int16_t>(NapiHelper::ExtractInt32(info[2], "cellY"));
-
-    auto cellOrWorld =
-      cellOrWorldDesc.ToFormId(partOne->worldState.pluginIndexMapping);
-    auto& br = partOne->GetEspm().GetBrowser();
-    auto& cache = partOne->worldState.GetEspmCache();
-
-    auto env = info.Env();
-    auto result = Napi::Array::New(env);
-    uint32_t n = 0;
-
-    auto recordsBySource = br.GetRecordsAtPos(cellOrWorld, cellX, cellY);
-    for (size_t i = 0; i < recordsBySource.size(); ++i) {
-      const auto source = static_cast<espm::SourceId>(i);
-      for (auto rec : *recordsBySource[i]) {
-        const bool isActor = espm::utils::Is<espm::ACHR>(rec->GetType());
-        if (!isActor && !espm::utils::Is<espm::REFR>(rec->GetType())) {
-          continue;
-        }
-        auto* refr = reinterpret_cast<const espm::REFR*>(rec);
-        auto data = refr->GetData(cache);
-        if (!data.loc) {
-          continue;
-        }
-
-        uint32_t id;
-        try {
-          id = br.ResolveRecordFormId(source, rec->GetId());
-        } catch (const espm::ResolveError&) {
-          continue;
-        }
-        auto baseId = br.TryResolveReferencedFormId(source, data.baseId);
-        if (!baseId) {
-          continue;
-        }
-
-        auto pos = Napi::Array::New(env, 3);
-        for (uint32_t k = 0; k < 3; ++k) {
-          pos.Set(k, Napi::Number::New(env, data.loc->pos[k]));
-        }
-
-        auto item = Napi::Object::New(env);
-        item.Set("id", Napi::Number::New(env, id));
-        item.Set("baseId", Napi::Number::New(env, *baseId));
-        item.Set("flags", Napi::Number::New(env, rec->GetFlags()));
-        item.Set("type", Napi::String::New(env, isActor ? "ACHR" : "REFR"));
-        item.Set("pos", pos);
-        result.Set(n++, item);
-      }
-    }
-
-    return result;
-  } catch (std::exception& e) {
-    throw Napi::Error::New(info.Env(), std::string(e.what()));
-  }
-}
